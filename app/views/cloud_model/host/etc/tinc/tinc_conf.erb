Name = <%=raw host.name.downcase.gsub('-', '_') %>
AddressFamily = ipv4
BindToInterface = eth0
<% CloudModel::Host.tinc_peers_of(host).each do |peer| -%>
ConnectTo = <%= peer.tinc_name %>
<% end-%>
Device = /dev/net/tun
Mode = router
# Short key lifetime: a node that restarts while a lingering edge (e.g. a
# VPN client's) keeps it "reachable" is not re-keyed by its peers, which
# then send with a stale key until the next regeneration — this bounds that.
KeyExpire = 600
PrivateKeyFile = /etc/tinc/vpn/rsa_key.priv

# Socket buffers for packet bursts from one peer (config.tinc_udp_buffer;
# the kernel caps them at net.core.rmem_max/wmem_max, see sysctl.d/60-tinc.conf)
UDPRcvBuf = <%= CloudModel.config.tinc_udp_buffer %>
UDPSndBuf = <%= CloudModel.config.tinc_udp_buffer %>
