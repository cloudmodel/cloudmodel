Name = <%=raw host.name.downcase.gsub('-', '_') %>
AddressFamily = ipv4
BindToInterface = eth0
<% (CloudModel::Host.where(:tinc_public_key.ne => nil) - [host]).map{|h| h.name.downcase}.each do |name| -%>
ConnectTo = <%= name %>
<% end-%>
Device = /dev/net/tun
Mode = router
KeyExpire = 3600
PrivateKeyFile = /etc/tinc/vpn/rsa_key.priv

# Socket buffers for packet bursts from one peer (config.tinc_udp_buffer;
# the kernel caps them at net.core.rmem_max/wmem_max, see sysctl.d/60-tinc.conf)
UDPRcvBuf = <%= CloudModel.config.tinc_udp_buffer %>
UDPSndBuf = <%= CloudModel.config.tinc_udp_buffer %>
