[Service]
LimitFSIZE=infinity
LimitCPU=infinity
LimitAS=infinity
LimitMEMLOCK=infinity
LimitNOFILE=65000
LimitNPROC=65000
PermissionsStartOnly=true
TimeoutStartSec=600
# The data must belong to the mongod user before mongod opens it, so this one stays in
# front of the start. Only what is actually wrong gets changed: a chown to the
# same owner still rewrites every inode's ctime, which on ZFS is a metadata
# write per file — at every start, for every file of the data directory.
<%- user = model.mongodb_user -%>
ExecStartPre=/bin/chown <%= user %>:<%= user %> /var/lib/mongodb
ExecStartPre=/bin/sh -c 'find /var/lib/mongodb ! -user <%= user %> -exec chown -h <%= user %> {} + ; find /var/lib/mongodb ! -group <%= user %> -exec chgrp -h <%= user %> {} +'
