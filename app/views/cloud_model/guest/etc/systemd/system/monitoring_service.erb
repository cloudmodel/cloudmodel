[Unit]
Description=CloudModel Monitoring Worker
After=syslog.target network.target
AssertPathExists=/var/www/rails/current

[Service]
Type=simple
WorkingDirectory=/var/www/rails/current

ExecStart=/bin/bash -lc 'RAILS_ENV=production /usr/local/rvm/bin/rvm default do bundle exec rake cloudmodel:monitoring:check'
KillSignal=SIGINT
User=www
Group=www
UMask=0002

# Restart after 1 minute delay
Restart=always
RestartSec=180
# A cycle takes well under an hour; one that runs for hours hangs on a dead
# connection (seen after a VPN restart: 19 h in futex wait on SSH sessions
# whose peers were gone). Kill it and let Restart start a fresh cycle.
RuntimeMaxSec=14400
TimeoutStopSec=60

StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=cloudmodel_monitoring

[Install]
WantedBy=multi-user.target