# Rendered by cloudmodel, do not edit on the guest.
log:
  level: <%= model.log_level %>
  job_level: <%= model.log_level %>

runner:
  file: /var/lib/forgejo-runner/.runner
  capacity: <%= model.capacity %>
  timeout: 3h
  shutdown_timeout: 3h
  insecure: false
  fetch_timeout: 30s
  fetch_interval: 2s
  report_interval: 1s
  # Tool chains from the guest template, reachable without a login shell.
  envs:
<% model.job_environment.each do |key, value| -%>
    <%= key %>: <%= value.to_json %>
<% end -%>
  labels:
<% model.effective_labels.each do |label| -%>
    - <%= label.to_json %>
<% end -%>

cache:
  enabled: true
  dir: /var/lib/forgejo-runner/cache

container:
  # No container engine in the guest; jobs run with the host executor.
  docker_host: "-"

host:
  workdir_parent: /var/lib/forgejo-runner/work

server:
  connections:
    forgejo:
      url: <%= model.effective_instance_url.to_json %>
      uuid: <%= model.runner_uuid %>
      token: <%= model.registration_secret %>
