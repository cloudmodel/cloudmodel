storage:
    dbPath: "/var/lib/mongodb"
    wiredTiger:
        engineConfig:
            cacheSizeGB: <%= model.effective_wiredtiger_cache_size_gb %>

net:
    port: <%= model.port %>
    #bindIp: 127.0.0.1
    bindIp: 0.0.0.0
    ssl:
        mode: disabled
<%- if model.mongodb_replication_set or model.percona? -%>

setParameter:
<%- if model.mongodb_replication_set -%>
   disableSplitHorizonIPCheck: true
<%- end -%>
<%- if model.percona? -%>
   perconaTelemetry: <%= model.telemetry ? 'true' : 'false' %>
<%- end -%>
<%- end -%>
<%- if model.mongodb_replication_set -%>

replication:
   replSetName: <%= model.mongodb_replication_set.name %>
<%- end -%>