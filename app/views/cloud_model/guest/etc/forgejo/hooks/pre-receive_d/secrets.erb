#!/bin/bash
# Rendered by cloudmodel, do not edit on the guest. Pre-receive hook, linked
# into every repository's hooks/pre-receive.d by /etc/forgejo/link-hooks.sh:
# rejects a push when gitleaks finds a secret in the pushed commits.
# stdin: "<old> <new> <ref>" per updated ref.
set -u
ZERO=0000000000000000000000000000000000000000
CONFIG=/etc/forgejo/gitleaks.toml
REPORT=$(mktemp /tmp/gitleaks.XXXXXX)
trap 'rm -f "$REPORT"' EXIT

# Bypass for a documented false positive: git push -o secrets-skip="<reason>".
# The reason ends up in the Forgejo log (stderr of the hook) as the audit trail.
for i in $(seq 0 $(( ${GIT_PUSH_OPTION_COUNT:-0} - 1 ))); do
  var="GIT_PUSH_OPTION_$i"
  case "${!var:-}" in
    secrets-skip=*) echo "secret scanning skipped on request of the pusher: ${!var#secrets-skip=}" >&2; exit 0 ;;
  esac
done

status=0
while read -r old new ref; do
  [ "$new" = "$ZERO" ] && continue
  if [ "$old" = "$ZERO" ]; then range="$new --not --all"; else range="$old..$new"; fi
  if ! timeout 120 gitleaks git . --config "$CONFIG" --log-opts="$range" --redact --no-banner --exit-code 1 >"$REPORT" 2>&1; then
    if grep -q "^Finding:" "$REPORT"; then
      echo "*** Push to $ref rejected: secrets found in the pushed commits (gitleaks)." >&2
      grep -E "^(RuleID|File|Line|Commit|Fingerprint):" "$REPORT" | sed 's/^/    /' >&2
      echo "    Remove the secret from the commits (amend or rebase) and push again; a false positive can be allowlisted in the Forgejo service or bypassed once with: git push -o secrets-skip=\"reason\"" >&2
      status=1
    else
      # gitleaks itself failed (timeout, broken config): do not block pushes on a scanner error, but say so.
      echo "warning: secret scanning of $ref did not complete: $(tail -1 "$REPORT")" >&2
    fi
  fi
done
exit $status
