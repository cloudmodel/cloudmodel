APP_NAME = <%= model.name %>
RUN_USER = forgejo
WORK_PATH = /var/lib/forgejo
RUN_MODE = prod

[database]
DB_TYPE = sqlite3
PATH = /var/lib/forgejo/data/forgejo.db
LOG_SQL = false

[repository]
ROOT = /var/lib/forgejo/data/forgejo-repositories

[server]
SSH_DOMAIN = <%= guest.external_hostname %>
DOMAIN = <%= guest.external_hostname %>
HTTP_PORT = <%= model.port %>
ROOT_URL = https://<%= guest.external_hostname %>/
APP_DATA_PATH = /var/lib/forgejo/data
DISABLE_SSH = false
SSH_PORT = 22
START_SSH_SERVER = false
LFS_START_SERVER = true
LFS_JWT_SECRET = <%= model.lfs_jwt_secret %>
OFFLINE_MODE = false

[lfs]
PATH = /var/lib/forgejo/data/lfs

[packages]
ENABLED = <%= model.packages_enabled ? 'true' : 'false' %>

[mailer]
ENABLED = <%= model.mailer_enabled ? 'true' : 'false' %>
<% if model.mailer_enabled %>
; Through the guest's sendmail (msmtp relays via the host).
PROTOCOL = sendmail
SENDMAIL_PATH = /usr/sbin/sendmail
FROM = <%= model.effective_mail_from %>
<% end %>

[ui]
DEFAULT_THEME = <%= model.default_theme %>

[service]
REGISTER_EMAIL_CONFIRM = false
ENABLE_NOTIFY_MAIL = <%= model.mailer_enabled ? 'true' : 'false' %>
DISABLE_REGISTRATION = true
ALLOW_ONLY_EXTERNAL_REGISTRATION = <%= model.oidc? && model.oidc_auto_registration ? 'true' : 'false' %>
<% if model.external_login_only? %>
; The external login source is the only way in.
ENABLE_INTERNAL_SIGNIN = false
ENABLE_BASIC_AUTHENTICATION = false
<% else %>
ENABLE_INTERNAL_SIGNIN = true
ENABLE_BASIC_AUTHENTICATION = true
<% end %>
ENABLE_CAPTCHA = false
REQUIRE_SIGNIN_VIEW = false
DEFAULT_KEEP_EMAIL_PRIVATE = false
DEFAULT_ALLOW_CREATE_ORGANIZATION = true
DEFAULT_ENABLE_TIMETRACKING = true
NO_REPLY_ADDRESS = noreply.<%= guest.external_hostname %>

[oauth2_client]
ENABLE_AUTO_REGISTRATION = <%= model.oidc_auto_registration ? 'true' : 'false' %>
ACCOUNT_LINKING = <%= model.oidc_account_linking %>
USERNAME = nickname
UPDATE_AVATAR = false

[openid]
ENABLE_OPENID_SIGNIN = <%= model.enable_openid_signin ? 'true' : 'false' %>
ENABLE_OPENID_SIGNUP = <%= model.enable_openid_signup ? 'true' : 'false' %>

[actions]
ENABLED = <%= model.actions_enabled ? 'true' : 'false' %>
DEFAULT_ACTIONS_URL = <%= model.actions_default_url %>

[cron.update_checker]
ENABLED = false

[session]
PROVIDER = file

[log]
; Console under systemd = journald (Forgejo switches to journald flags itself).
MODE = console
LEVEL = info
ROOT_PATH = /var/lib/forgejo/log

[repository.pull-request]
DEFAULT_MERGE_STYLE = merge

[repository.signing]
DEFAULT_TRUST_MODEL = committer

[security]
INSTALL_LOCK = true
INTERNAL_TOKEN = <%= model.internal_token %>
PASSWORD_HASH_ALGO = pbkdf2_hi

[oauth2]
JWT_SECRET = <%= model.oauth_jwt_secret %>

[metrics]
ENABLED = true
