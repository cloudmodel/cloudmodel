
index                           index.html;
<%- if model.additional_mime_types.present? -%>

# In addition to mime.types (a types block at http level adds, inside server it would replace)
types {
<%- model.additional_mime_types.each do |ext, type| -%>
  <%= type.to_s.ljust(29) %> <%= ext %>;
<%- end -%>
}
<%- end -%>
<%- if model.basic_auth? -%>

# Basic auth: the realm per request, "off" for the ACME challenge (certbot)<%= ' and for the private network' if model.basic_auth_private_network_bypass? %>.
geo $cloudmodel_basic_auth_network {
  default                       outside;
<%- if model.basic_auth_private_network_bypass? -%>
  <%= CloudModel.config.tinc_network.ljust(29) %> private;
<%- end -%>
}
map "$cloudmodel_basic_auth_network:$uri" $cloudmodel_basic_auth {
  ~^private:                    off;
  ~^outside:/\.well-known/acme-challenge/ off;
  default                       "<%=raw model.basic_auth_realm %>";
}
<%- end -%>

<%-
protocols = []
protocols << :http unless model.ssl_supported? and model.ssl_only?
protocols << :https if model.ssl_supported?
-%>
<%- protocols.each do |protocol| -%>

server {
  listen                        <%= protocol == :https ? "#{model.ssl_port} ssl#{' http2' if model.http2?} deferred" : model.port %>;
<%- if model.ssl_certbot? -%>
  server_name                   <%= ([model.guest.external_hostname] + model.guest.external_alt_names) * ' ' %>;
<%- end -%>

<%- if protocol == :http and model.ssl_supported? and model.ssl_enforce? -%>
  add_header                    Cache-Control "public, must-revalidate";
  add_header                    Strict-Transport-Security max-age=63072000;
  expires                       90d;
  root                          /var/www/empty;
  location / {
    rewrite                     ^/(.*)$  https://<%= guest.external_hostname %>/$1  permanent;
    return                      444;
  }
<%- model.ssl_enforce_exceptions.each do |path| -%>

  # Served on plain http as well (clients that do not follow the switch to https)
  location ^~ <%= path %> {
    root                        <%= model.www_root %>/current/public/;
    try_files                   $uri =404;
    # Not the redirect's 90 days above: a file served here is current content.
    expires                     off;
    add_header                  Cache-Control "no-cache";
<%- if model.basic_auth? -%>
    auth_basic                  $cloudmodel_basic_auth;
    auth_basic_user_file        <%= CloudModel::Services::Nginx::BASIC_AUTH_USER_FILE %>;
<%- end -%>
  }
<%- end -%>
<%- else -%>
  root                          <%= model.www_root %>/current/public/;

  add_header Referrer-Policy "same-origin" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Download-Options "noopen" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-Permitted-Cross-Domain-Policies "none" always;
  # add_header X-Robots-Tag "none" always;
  add_header X-XSS-Protection "1; mode=block;" always;
  more_clear_headers 'Server' 'X-Powered-By' 'X-Runtime';
  add_header Content-Security-Policy "<%=raw model.content_security_policy %>" always;
  add_header Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" always;
<%- if model.basic_auth? -%>

  # Basic auth in front of the site (realm map above)
  auth_basic                    $cloudmodel_basic_auth;
  auth_basic_user_file          <%= CloudModel::Services::Nginx::BASIC_AUTH_USER_FILE %>;
<%- end -%>

  # Remove X-Powered-By, which is an information leak
  fastcgi_hide_header X-Powered-By;

  client_max_body_size          <%= model.client_max_body_size.to_i > 0 ? "#{model.client_max_body_size.to_i}M" : 0 %>;
  client_body_buffer_size       128k;
  client_header_timeout         30m;
  client_body_timeout           30m;
  send_timeout                  30m;
  # Compression
  gzip                          on;
  gzip_buffers                  16 8k;
  # compression level between 1 and 9
  gzip_comp_level               9;
  gzip_http_version             1.0;
  gzip_min_length               0;
  gzip_types                    text/plain text/css image/x-icon image/bmp application/x-javascript text/xml application/xml application/xml+rss text/javascript;
  gzip_vary                     on;
  gzip_proxied                  any;
  # Some version of IE 6 don't handle compression well on some mime-types, so just disable them
  gzip_disable                  "MSIE [1-6].(?!.*SV1)";

<%- if protocol == :https -%>
  <%- if model.ssl_enforce? or model.ssl_only? -%>
  add_header                    Strict-Transport-Security max-age=63072000 always;
  <%- end -%>
<%- if model.ssl_certbot? && defined?(certbot_cert_available) && certbot_cert_available -%>
  ssl_certificate               /etc/letsencrypt/live/<%= guest.external_hostname %>/fullchain.pem;
  ssl_certificate_key           /etc/letsencrypt/live/<%= guest.external_hostname %>/privkey.pem;
<%- else -%>
  ssl_certificate               ssl/<%= guest.external_hostname %>.crt;
  ssl_certificate_key           ssl/<%= guest.external_hostname %>.key;
<%- end -%>
<%- unless model.ssl_certbot? -%>
  ssl_client_certificate        ssl/<%= guest.external_hostname %>.ca.crt;
<%- end -%>
  ssl_dhparam                   ssl/dhparam.pem;
  ssl_session_timeout           10m;

  ssl_protocols                 TLSv1.3 TLSv1.2;
  ssl_prefer_server_ciphers     on;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
  ssl_stapling                  <%= model.ssl_stapling ? 'on' : 'off' %>;
  ssl_stapling_verify           <%= model.ssl_stapling ? 'on' : 'off' %>;
  resolver                      8.8.4.4 8.8.8.8 valid=300s;
  resolver_timeout              10s;
  ssl_session_cache             shared:SSL:10m;

<%- end -%>
  location = /robots.txt {
    allow all;
    log_not_found off;
    access_log off;
  }

  location /nginx_status {
    stub_status                 on;
    access_log                  off;
<%- if model.basic_auth? -%>
    auth_basic                  off;
<%- end -%>
    allow                       <%= model.host.private_network.ip %>/16;
    deny all;
  }

  include /etc/nginx/server.d/*;
<%- end -%>
}
<%- end -%>
