<%- location ||= '/' %>
#passenger_enabled           on;

location <%= location %> {
  root                              <%= model.www_root %>/current/public;
  passenger_base_uri                <%= location %>;
  passenger_app_root                <%= model.www_root %>/current;
  passenger_document_root           <%= model.www_root %>/current/public;
  passenger_enabled                 on;
  passenger_min_instances           3;
  passenger_env_var                 HTTP_X_FORWARDED_PROTO $scheme;
  <%- if model.deploy_web_image&.additional_components&.map(&:to_s)&.include?('puppeteer') -%>
  # grover/Puppeteer launches the distro Chromium (Puppeteer component); its own
  # node context does not read the app's .puppeteerrc.cjs, so pin the path here.
  passenger_env_var                 PUPPETEER_EXECUTABLE_PATH /usr/bin/chromium;
  <%- end -%>
  passenger_app_env                 <%= model.passenger_env %>;
  passenger_preload_bundler         on;

  location ~ ^/assets/ {
    expires                         max;
    add_header                      Cache-Control public;
    access_log                      off;
  }
  <%- if model.rails_cable_supported -%>

  # ActionCable WebSocket: own app group with unlimited concurrency, so open
  # sockets don't occupy regular Passenger app processes.
  location <%= location.chomp('/') %>/cable {
    passenger_app_group_name        <%= model.guest.name %>_cable;
    passenger_force_max_concurrent_requests_per_process 0;
  }
  <%- end -%>
  <%- model.location_overwrites.each do |f| -%>
    <%- if f.location =~ /^#{location}/ -%>

  location ~ ^<%= f.location %> {
    <%= (f.overwrites.map{|k,v| "    #{k.to_s.ljust(31)} #{v};"} * "\n").strip %>
  }
    <%- end -%>
  <%- end -%>
}
