#!/bin/bash
# Periodically snapshots the cgroup's cumulative CPU usage (nanoseconds) into
# /var/cache/cgroup_load so the cgroup_cpu plugin can compute usage percentages
# over time. Must read the same source/units as cgroup_cpu (v1 per-CPU ns; v2
# cpu.stat usage_usec → ns).
mkdir -p /var/cache/cgroup_load

read_cpu_usage() {
  if [ -r /sys/fs/cgroup/cpu/cpuacct.usage_percpu ]; then
    cat /sys/fs/cgroup/cpu/cpuacct.usage_percpu
  elif [ -r /sys/fs/cgroup/cpuacct/cpuacct.usage_percpu ]; then
    cat /sys/fs/cgroup/cpuacct/cpuacct.usage_percpu
  elif [ -r /sys/fs/cgroup/cpu.stat ]; then
    u=$(awk '/^usage_usec /{print $2}' /sys/fs/cgroup/cpu.stat)
    [ -n "$u" ] && echo $(( u * 1000 ))
  fi
}

usage=$(read_cpu_usage)
[ -n "$usage" ] && echo "$usage" > "/var/cache/cgroup_load/$(date +%s%N)"

# Keep only the newest 60 snapshots.
ls -t /var/cache/cgroup_load/* 2>/dev/null | awk 'NR>60' | xargs -r rm -f
